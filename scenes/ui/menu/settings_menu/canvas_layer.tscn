[sub_resource type="Shader" id="Shader_mx0kw"]
code = "shader_type canvas_item;

uniform float pulse_speed : hint_range(0.1, 10.0) = 4.0;
uniform float pulse_amount : hint_range(0.0, 1.0) = 0.4;
uniform float tremble_speed : hint_range(0.1, 20.0) = 15.0;
uniform float tremble_strength : hint_range(0.0, 10.0) = 1.5;

void vertex() {
    // Дрожь: слегка сдвигаем вершины линии с помощью синусоиды
    VERTEX.x += sin(TIME * tremble_speed + VERTEX.y * 0.1) * tremble_strength;
}

void fragment() {
    // Пульсация: заставляем прозрачность (Альфу) дышать
    float pulse = 1.0 - (sin(TIME * pulse_speed) * 0.5 + 0.5) * pulse_amount;
    COLOR.a *= pulse;
}"

