[sub_resource type="Shader" id="Shader_0o4t1"]
code = "shader_type canvas_item;

uniform vec4 shine_color : source_color = vec4(1.0, 1.0, 1.0, 0.8); 
uniform float speed = 1.5; // Сделали чуть медленнее и плавнее

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);
    
    // Сделали волны крупнее
    float wave1 = sin(UV.x * 5.0 + UV.y * 5.0 - TIME * speed);
    // Расширили границу блика (было 0.95, стало 0.7) - теперь его отлично видно!
    float shine1 = smoothstep(0.7, 1.0, wave1);
    
    float wave2 = sin(UV.x * 8.0 + UV.y * 8.0 - TIME * (speed * 1.2));
    float shine2 = smoothstep(0.8, 1.0, wave2) * 0.6; 
    
    float total_shine = clamp(shine1 + shine2, 0.0, 1.0);
    
    COLOR.rgb = mix(tex_color.rgb, shine_color.rgb * tex_color.rgb, total_shine);
    COLOR.a = tex_color.a * COLOR.a;
}"

